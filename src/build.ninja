# ===================== 工具链配置 =====================
BIN_DIR = E:/MyOS/tools/i686-elf-tools-windows/bin
ASM     = E:/MyOS/tools/NASM/nasm.exe
QEMU    = E:/MyOS/tools/qemu-portable-20241220/qemu-system-x86_64.exe

CC      = $BIN_DIR/i686-elf-gcc.exe
LD      = $BIN_DIR/i686-elf-ld.exe
OBJCOPY = $BIN_DIR/i686-elf-objcopy.exe

# ===================== 编译链接选项 =====================
CFLAGS  = -ffreestanding -O2 -Wall -Wextra -Ikernel -MMD
LDFLAGS = -m elf_i386 -T linker.ld --oformat binary -e _start

# ===================== 规则定义 =====================
rule asm_bin
    command = $ASM -f bin $in -o $out
    description = NASM(bin) $in

rule asm_elf
    command = $ASM -f elf32 $in -o $out
    description = NASM(elf) $in

rule cc
    command = $CC $CFLAGS -c $in -o $out
    description = CC $in
    depfile = $out.d
    deps = gcc

rule link
    command = $LD $LDFLAGS -o $out $in
    description = LINK $out

rule objcopy_pad
    command = $OBJCOPY -I binary -O binary --pad-to 65536 $in $out
    description = PAD $out

rule make_os_image
    command = cmd /c copy /b boot\boot.bin + kernel.bin os-image.bin >nul
    description = BUILD os-image.bin

rule make_disk
    command = cmd /c if not exist disk.img fsutil file createnew disk.img 16777216
    description = CHECK DISK IMAGE

rule run_qemu
    command = $QEMU -drive format=raw,file=os-image.bin -drive format=raw,file=disk.img
    description = RUN EZOS

# ===================== 构建目标 =====================
build boot/boot.bin: asm_bin boot/boot.asm
build boot/kernel_entry.o: asm_elf boot/kernel_entry.asm

build kernel/kernel.o: cc kernel/kernel.c
build kernel/tty.o: cc kernel/tty.c
build kernel/idt.o: cc kernel/idt.c
build kernel/isr.o: cc kernel/isr.c
build kernel/keyboard.o: cc kernel/keyboard.c
build kernel/ata.o: cc kernel/ata.c
build kernel/shell.o: cc kernel/shell.c
build kernel/exfat.o: cc kernel/exfat.c
# build kernel/gfx.o: cc kernel/gfx.c  # gfx 图形模式已注释
build kernel/gui.o: cc kernel/gui.c
build kernel/mouse.o: cc kernel/mouse.c

build kernel_raw.bin: link boot/kernel_entry.o kernel/kernel.o kernel/tty.o kernel/idt.o kernel/isr.o kernel/keyboard.o kernel/ata.o kernel/shell.o kernel/exfat.o kernel/gui.o kernel/mouse.o

build kernel.bin: objcopy_pad kernel_raw.bin

build os-image.bin: make_os_image boot/boot.bin kernel.bin

build disk_img_check: make_disk

build run: run_qemu os-image.bin disk_img_check

default run

build clean: phony
    command = cmd /c del /q boot\boot.bin boot\kernel_entry.o kernel\*.o kernel\*.d kernel_raw.bin kernel.bin os-image.bin 2>nul
